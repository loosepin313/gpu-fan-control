[Unit]
Description=GPU Fan Control Service
After=multi-user.target lm_sensors.service
Wants=lm_sensors.service
# Transient problems (Super I/O driver slow to register, GPU re-enumerating)
# are retried inside the script, so they never reach this counter. What does
# reach it is a hard configuration error - a bad PWM_CHANNEL, for example.
# Without a limit that becomes an endless restart loop; one real deployment
# accumulated 9796 restarts after the GPU it pointed at was moved to another
# machine. Better to land in a visible 'failed' state.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Give the Super I/O driver time to register its hwmon device before the
# control loop starts looking for it.
ExecStartPre=/bin/sleep 15
ExecStart=/usr/local/bin/gpu-fan-control.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
